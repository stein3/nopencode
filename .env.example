ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HOST_WORKSPACE=/path/to/workspace

# Vite base for the webui baked into the opencode-web image. Leave empty for the
# repo default (root: the app requests /assets/*, /sw.js, /manifest.webmanifest).
# Set to /webui/ ONLY when this container sits behind a prefix-stripping subpath
# proxy (e.g. Caddy `handle_path /webui/*`), where the browser must request
# /webui/assets/* instead. Affects the image build, never the running container.
WEBUI_BASE=
